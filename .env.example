# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Frontend origin for CORS (set to your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# ── P1: HubSpot CRM (free tier) ──────────────────────────────────────────────
# Get from: HubSpot → Settings → Integrations → API Key (or Private App token)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# ── P1: Google Sheets ────────────────────────────────────────────────────────
# The spreadsheet ID from the URL: /spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── P1 + P2: Google Service Account (for Sheets + Calendar) ──────────────────
# Paste the full JSON content of your service account key (as a single-line JSON string)
# In Vercel, set this as an environment variable — never commit this value
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── P2: Google Calendar ───────────────────────────────────────────────────────
# The calendar ID — use "primary" or a specific calendar ID from Google Calendar settings
GOOGLE_CALENDAR_ID=primary

# ── P2: Resend email notification ────────────────────────────────────────────
# Sign up free at resend.com and verify your sending domain
RESEND_API_KEY=re_your_resend_api_key_here
# The verified sender address (must be on your verified domain in Resend)
EMAIL_FROM=leads@yourdomain.com
# Notification recipient — as per the assignment
NOTIFY_EMAIL=ai-labs@hexanovate.com
