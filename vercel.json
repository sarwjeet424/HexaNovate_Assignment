{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/submit-lead", "dest": "/api/submit-lead.js" },
    { "src": "/api/book-calendar", "dest": "/api/book-calendar.js" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
